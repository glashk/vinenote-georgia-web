rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Memarne — user-scoped access rules.
    // Deploy: firebase deploy --only firestore:rules

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwnerByResource() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isOwnerByRequest() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Users: user can read/write self; admin can read any
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /favorites/{listingId} {
        allow read, create, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /pushTokens/{tokenId} {
        allow read, create, update: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Finance
    match /finance/{financeId} {
      allow create: if isOwnerByRequest();
      allow read: if isOwnerByResource();
      allow update: if isOwnerByResource() && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwnerByResource();
    }

    // App collections (vineyards, tasks, harvests, etc.)
    match /vineyards/{id}      { allow create: if isOwnerByRequest(); allow read, update, delete: if isOwnerByResource(); }
    match /vineyardBlocks/{id} { allow create: if isOwnerByRequest(); allow read, update, delete: if isOwnerByResource(); }
    match /tasks/{id}          { allow create: if isOwnerByRequest(); allow read, update, delete: if isOwnerByResource(); }
    match /harvests/{id}       { allow create: if isOwnerByRequest(); allow read, update, delete: if isOwnerByResource(); }
    match /containers/{id}     { allow create: if isOwnerByRequest(); allow read, update, delete: if isOwnerByResource(); }
    match /wineBatches/{id}    { allow create: if isOwnerByRequest(); allow read, update, delete: if isOwnerByResource(); }
    match /inventory/{id}      { allow create: if isOwnerByRequest(); allow read, update, delete: if isOwnerByResource(); }
    match /entries/{id}        { allow create: if isOwnerByRequest(); allow read, update, delete: if isOwnerByResource(); }

    function listingCoreFieldsUnchanged() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.get('phone', null) == resource.data.get('phone', null)
        && request.resource.data.get('variety', null) == resource.data.get('variety', null)
        && request.resource.data.get('title', null) == resource.data.get('title', null)
        && request.resource.data.get('price', null) == resource.data.get('price', null)
        && request.resource.data.get('quantity', null) == resource.data.get('quantity', null)
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.get('hidden', null) == resource.data.get('hidden', null)
        && request.resource.data.get('description', null) == resource.data.get('description', null)
        && request.resource.data.get('category', null) == resource.data.get('category', null);
    }

    function isViewAnalyticsUpdate() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      let prevViews = resource.data.get('viewsCount', 0);
      return diff.hasOnly(['viewsCount', 'lastViewedAt'])
        && request.resource.data.viewsCount == prevViews + 1
        && request.resource.data.lastViewedAt is timestamp
        && request.resource.data.lastViewedAt <= request.time
        && request.resource.data.lastViewedAt > request.time - duration.value(5, 'm')
        && listingCoreFieldsUnchanged();
    }

    function isPhoneClickAnalyticsUpdate() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      let prevClicks = resource.data.get('phoneClicksCount', 0);
      return diff.hasOnly(['phoneClicksCount', 'lastPhoneClickedAt'])
        && request.resource.data.phoneClicksCount == prevClicks + 1
        && request.resource.data.lastPhoneClickedAt is timestamp
        && request.resource.data.lastPhoneClickedAt <= request.time
        && request.resource.data.lastPhoneClickedAt > request.time - duration.value(5, 'm')
        && listingCoreFieldsUnchanged();
    }

    function isPublicListingAnalyticsUpdate() {
      return isViewAnalyticsUpdate() || isPhoneClickAnalyticsUpdate();
    }

    function isValidAnalyticsEvent(listingId) {
      return request.resource.data.type in ['view', 'phone_click']
        && request.resource.data.listingId == listingId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'type', 'listingId', 'listingOwnerId', 'userId', 'createdAt', 'userAgent'
        ]);
    }

    // Market listings: public read; owner create/update/delete; admin can moderate
    match /marketListings/{id} {
      allow read: if true;
      allow create: if isOwnerByRequest();
      allow update: if isOwnerByResource() || isAdmin() || isPublicListingAnalyticsUpdate();
      allow delete: if isOwnerByResource() || isAdmin();

      match /analyticsEvents/{eventId} {
        allow create: if isValidAnalyticsEvent(id);
        allow read: if isAdmin()
          || (isSignedIn()
            && get(/databases/$(database)/documents/marketListings/$(id)).data.userId
              == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // Presence: visitor tracking (anonymous create/update; admin read)
    match /presence/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if true;
    }

    // Reports: moderation (App Store 1.2 safety)
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if (isSignedIn() && resource.data.reporterId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
